    "import geopy as gp\n",
    "geolocator = gp.geocoders.Nominatim(user_agent='UCSD_Data_Science_Project')\n",
    "\n",
    "def find_state(latitude, longitude):\n",
    "    lat = str(latitude)\n",
    "    long = str(longitude)\n",
    "    \n",
    "    try:\n",
    "        location = geolocator.geocode(lat+\",\"+long)\n",
    "    except(gp.exc.GeocoderTimedOut):\n",
    "        return('NA')\n",
    "    \n",
    "    address = location.address\n",
    "\n",
    "    address_array = address.split(\", \")\n",
    "\n",
    "    for address_item in address_array:\n",
    "        if address_item in us_state_to_abbrev:\n",
    "            #print(us_state_to_abbrev[address_item])\n",
    "            return us_state_to_abbrev[address_item]\n"
   ]
  },
