   "source": [
    "# Group temp data by city and year to compute mean, std dev, and range\n",
    "weather_summary = city_temperature_data.groupby(['city name', 'year']).agg({\n",
    "    'temperature avg': ['mean', 'std'],\n",
    "    'temperature max': 'max',\n",
    "    'temperature min': 'min'\n",
    "}).reset_index()\n",
    "\n",
    "# Flatten multi-level column names\n",
    "weather_summary.columns = ['city name', 'year', 'mean temp', 'std dev temp', 'max temp', 'min temp']\n",
    "\n",
    "# Calculate temperature range\n",
    "weather_summary['range temp'] = weather_summary['max temp'] - weather_summary['min temp']\n",
    "weather_summary.head()"
   ]
