    "def get_year(date_string):\n",
    "    return int(date_string[0:4])\n",
    "\n",
    "def get_month(date_string):\n",
    "    return int(date_string[5:7])\n",
    "\n",
    "def get_day(date_string):\n",
    "    return int(date_string[8:10])\n",
    "\n",
    "city_temperature_data['year'] = city_temperature_data['date'].apply(get_year)\n",
    "city_temperature_data['month'] = city_temperature_data['date'].apply(get_month)\n",
    "city_temperature_data['day'] = city_temperature_data['date'].apply(get_day)\n",
    "\n",
    "city_temperature_data"
   ]
