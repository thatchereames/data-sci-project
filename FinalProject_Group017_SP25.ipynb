    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from scipy.stats import pearsonr\n",
    "\n",
    "# --- Making a copy of combined_df ---\n",
    "subset_df = combined_df.copy()\n",
    "\n",
    "# --- Bring in population data from mental_health_data ---\n",
    "pop_data = mental_health_data[['city name', 'year', 'population']]\n",
    "\n",
    "# Make sure there’s no whitespace or case problems\n",
    "pop_data['city name'] = pop_data['city name'].str.strip().str.lower()\n",
    "subset_df['city name'] = subset_df['city name'].str.strip().str.lower()\n",
    "\n",
    "# Merge population into subset_df\n",
    "subset_df = pd.merge(subset_df, pop_data, on=['city name', 'year'], how='left')\n",
    "\n",
    "# --- Drop duplicate city-year rows ---\n",
    "subset_df = subset_df.drop_duplicates(subset=['city name', 'year'])\n",
    "\n",
    "# --- Drop rows where population is missing ---\n",
    "subset_df = subset_df.dropna(subset=['population'])\n",
    "\n",
    "# --- Compute median and split ---\n",
    "median_pop = subset_df['population'].median()\n",
    "\n",
    "large_cities = subset_df[subset_df['population'] >= median_pop]\n",
    "small_cities = subset_df[subset_df['population'] < median_pop]\n",
    "\n",
    "# --- Compute Correlation for large cities ---\n",
    "r_large, _ = pearsonr(large_cities['mental distress %'], large_cities['std dev temp'])\n",
    "\n",
    "# --- Plot large cities ---\n",
    "plt.figure(figsize=(10, 6))\n",
    "sns.regplot(\n",
    "    data=large_cities,\n",
    "    x='mental distress %',\n",
    "    y='std dev temp',\n",
    "    scatter_kws={'s': 80, 'alpha': 0.7},\n",
    "    line_kws={'color': 'red'},\n",
    ")\n",
    "\n",
    "# Add correlation coefficient text\n",
    "plt.text(\n",
    "    0.05, 0.95,\n",
    "    f'r = {r_large:.2f}',\n",
    "    transform=plt.gca().transAxes,\n",
    "    fontsize=12,\n",
    "    verticalalignment='top'\n",
    ")\n",
    "\n",
    "plt.title('Mental Distress vs. Temperature Variability (Larger Cities)')\n",
    "plt.xlabel('Frequent Mental Distress (%)')\n",
    "plt.ylabel('Temperature Std Dev (°F)')\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# --- Compute correlation for small cities ---\n",
    "valid_small = small_cities.dropna(subset=['mental distress %', 'std dev temp'])\n",
    "r_small, _ = pearsonr(valid_small['mental distress %'], valid_small['std dev temp'])\n",
    "\n",
    "# --- Plot small cities ---\n",
    "plt.figure(figsize=(10, 6))\n",
    "sns.regplot(\n",
    "    data=small_cities,\n",
    "    x='mental distress %',\n",
    "    y='std dev temp',\n",
    "    scatter_kws={'s': 80, 'alpha': 0.7},\n",
    "    line_kws={'color': 'red'},\n",
    ")\n",
    "\n",
    "# Add correlation coefficient text\n",
