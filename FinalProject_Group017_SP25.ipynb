    "city_temperature_data_unclean = pd.DataFrame()\n",
    "\n",
    "for ind in ctd_key.index:\n",
    "    city_name = ctd_key.iloc[ind,1]\n",
    "    city_id = ctd_key.iloc[ind,2]\n",
    "    city_state = ctd_key.loc[ind,'State']\n",
    "    csv_file_name = 'Historical Weather Data/' + city_id + '.csv'\n",
    "    city_data_frame = pd.read_csv(csv_file_name)\n",
    "    city_data_frame.insert(loc=0, column='City', value=city_name)\n",
    "    city_data_frame.insert(loc=1, column='State', value=city_state)\n",
    "    city_temperature_data_unclean = pd.concat([city_temperature_data_unclean, city_data_frame])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 102,
   "metadata": {},
   "outputs": [],
   "source": [
    "def get_location(city_name, state_abv):\n",
    "    for state in us_state_abbrev:\n",
    "        city_name = city_name.replace(state, \"\")\n",
    "    city_name = city_name.lower()\n",
    "    city_name = city_name.strip()\n",
    "    city_name = city_name.replace(\" \", \"\")\n",
    "    return city_name + state_abv"
   ]
  },
